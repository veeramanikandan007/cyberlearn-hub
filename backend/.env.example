# Application Configuration
APP_NAME="CyberLearn Hub FastAPI & RAG Backend"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & CORS
SECRET_KEY="supersecret_cyberlearn_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# RAG & LLM Configuration
# Optional: Set your Google Gemini, OpenAI, or Groq API key here
# If no key is provided, the RAG service runs in Intelligent Knowledge Retrieval mode
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Vector Store Settings
VECTOR_DB_PATH="data/vector_store"
KNOWLEDGE_BASE_DIR="data/knowledge_base"
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.65
